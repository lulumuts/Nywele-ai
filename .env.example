#
# Copy this file to `.env.local` and fill in values.
#
# IMPORTANT:
# - Do NOT commit real secrets (API keys, service-role keys).
# - `.env.example` must contain placeholders only.
#

# Required for core AI features (server)
OPENAI_API_KEY=your_openai_api_key

# Optional: enables Claude text in `/api/style` (server)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: used by `lib/gemini.ts` if present
GEMINI_API_KEY=your_gemini_api_key

# Required for Supabase-backed data + analytics (used by both client + server init)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional (server only): bypass RLS for catalog reads (do NOT expose client-side)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Optional: Postgres schema + table for dashboard “Your recommended products” (defaults shown).
# Expose the schema under Supabase Dashboard → Settings → API → Exposed schemas.
# NEXT_PUBLIC_SUPABASE_CUSTOMER_PRODUCTS_SCHEMA=customer_products
# NEXT_PUBLIC_SUPABASE_CUSTOMER_PRODUCTS_TABLE=customer_products

# Optional: required if you call protected API routes from an “external” origin.
# (Most first-party browser calls should be treated as internal.)
NYWELE_API_KEY=your_shared_api_key_for_external_consumers

# Optional: required for `/api/analyze-image` (Vision API). Provide ONE of:
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key

# Not currently required by runtime code, but kept for future integrations.
CONVEX_DEPLOYMENT=your_convex_deployment